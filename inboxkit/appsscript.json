{
  "runtime": "nodejs22",
  "timeZone": "UTC",
  "dependencies": {
    "libraries": [],
    "enabledServices": []
  },
  "exceptionLogging": "STACKDRIVER",
  "marketplace": {
    "permissions": {
      "saleslumenScopes": [],
      "storage": [],
      "externalDomains": ["https://api.inboxkit.com"]
    },
    "connections": [
      {
        "kind": "API_KEY",
        "key": "cloudflare",
        "authorizationMode": "USER",
        "required": false,
        "displayLabel": "Cloudflare API token",
        "helpText": "Paste the Cloudflare API token used when connecting domains in InboxKit. The app sends that token to InboxKit with the connect request."
      },
      {
        "kind": "API_KEY",
        "key": "inboxkit",
        "authorizationMode": "USER",
        "required": true,
        "displayLabel": "InboxKit",
        "helpText": "Paste the InboxKit API key from Settings, API and Integrations. The app sends it as a bearer token."
      }
    ]
  }
}
