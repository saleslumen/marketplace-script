{
  "runtime": "nodejs22",
  "timeZone": "UTC",
  "dependencies": {
    "libraries": [],
    "enabledServices": []
  },
  "exceptionLogging": "STACKDRIVER",
  "marketplace": {
    "permissions": {
      "saleslumenScopes": [],
      "storage": [],
      "externalDomains": ["https://spaceship.dev"]
    },
    "connections": [
      {
        "kind": "API_KEY",
        "key": "spaceship",
        "authorizationMode": "USER",
        "required": true,
        "displayLabel": "Spaceship API key",
        "helpText": "Paste the Spaceship API key. The app sends it as the X-Api-Key header."
      },
      {
        "kind": "API_KEY",
        "key": "spaceshipSecret",
        "authorizationMode": "USER",
        "required": true,
        "displayLabel": "Spaceship API secret",
        "helpText": "Paste the Spaceship API secret. The app sends it as the X-Api-Secret header."
      }
    ]
  }
}
